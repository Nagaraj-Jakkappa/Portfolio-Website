# Environment Configuration
NODE_ENV=development

# Backend Settings
PORT=5180
JWT_SECRET=your_jwt_secret_here

# Client URLs (for CORS and CSRF validation)
# Use comma separation for multiple URLs
CLIENT_URLS=http://localhost:5173,https://www.techartistry.in

# Database
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio

# Cloudinary (Optional, for Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
