{
  "rewrites": [
    {
      "source": "/api/site/ping",
      "destination": "https://techartistry-api.onrender.com/api/site/ping"
    },
    {
      "source": "/api/:path*",
      "destination": "https://techartistry-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}